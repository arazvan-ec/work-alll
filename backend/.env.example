# Sportian - Environment Configuration Example
# Copy this file to .env and customize the values

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_this_to_a_random_string
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# For Docker:
DATABASE_URL="mysql://sportian:sportian@database:3306/sportian?serverVersion=8.0&charset=utf8mb4"
# For local development without Docker:
# DATABASE_URL="mysql://root:@127.0.0.1:3306/sportian?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/mailer ###
# For development (null transport - logs only):
MAILER_DSN=null://null
# For production with SMTP:
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
###< symfony/mailer ###

###> app/notification ###
NOTIFICATION_FROM_EMAIL=noreply@sportian.com
NOTIFICATION_TO_EMAIL=admin@sportian.com
###< app/notification ###
